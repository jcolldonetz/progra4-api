# ---------------------------------------------------------------------------
# progra4-api - configuracion del proyecto
#
# Copiar a .env para usar estos valores:  Copy-Item .env.example .env
# El archivo .env NO se versiona (esta en .gitignore); .env.example si.
#
# Prioridad de lectura:  variable de la terminal > .env > default del codigo.
# Es decir, lo que definas aca se usa SOLO si esa variable no esta ya definida
# en la terminal que arranca php (p. ej. serve-https.cmd define
# REPOSITORY_DRIVER y eso gana por encima de este archivo).
# ---------------------------------------------------------------------------

# Driver del repositorio: sqlite (archivo data/items.sqlite) | memory (RAM).
REPOSITORY_DRIVER=sqlite

# Secreto de firma HS256 de los tokens JWT. Debe coincidir con el JWT_SECRET
# del server progra4-notifications. Valor de desarrollo: cambiar en cualquier
# entorno real.
JWT_SECRET=secreto-solo-para-desarrollo-cambiar

# Vigencia del token en segundos.
JWT_TTL_SECONDS=3600

# Para realtime (pedidos en vivo): dejar VACIO apaga la publicacion y la API
# se comporta igual (NullEventPublisher). Con valor, publica cada pedido en el
# canal "items.stock" de Redis y progra4-notifications lo difunde por WebSocket.
REDIS_URL=127.0.0.1:6379

# Origenes permitidos para CORS, separados por coma. El default cubre el dev
# server de Vite en localhost/127.0.0.1:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173